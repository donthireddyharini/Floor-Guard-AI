import React, { useState } from 'react';
import {
  Video,
  Upload,
  Play,
  Pause,
  AlertTriangle,
  CheckCircle,
  FileText,
  Clock,
  Layers,
  BarChart2
} from 'lucide-react';

export const VideoAnalysisView: React.FC = () => {
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [progress, setProgress] = useState(100);
  const [selectedKeyframe, setSelectedKeyframe] = useState<number>(1);

  const videoMeta = {
    filename: 'warehouse_aisle_patrol_1080p.mp4',
    resolution: '1920x1080 @ 30 FPS',
    duration: '00:24',
    totalFrames: 720,
    analyzedFrames: 720,
    hazardsDetected: 3,
    safeFrames: 717
  };

  const keyframes = [
    {
      id: 0,
      timestamp: '00:02',
      frame: 60,
      detectedClass: 'Clean Floor',
      confidence: 0.98,
      severity: 'Safe',
      area: '0.00 m²',
      thumb: '/assets/samples/thumb_clean_floor.jpg',
      note: 'Clear walkway without surface puddles.'
    },
    {
      id: 1,
      timestamp: '00:06',
      frame: 180,
      detectedClass: 'Water Spill',
      confidence: 0.91,
      severity: 'High',
      area: '0.24 m²',
      thumb: '/assets/samples/thumb_water_spill.jpg',
      note: 'Surface liquid puddle spreading near entrance door.'
    },
    {
      id: 2,
      timestamp: '00:11',
      frame: 330,
      detectedClass: 'Water Spill',
      confidence: 0.94,
      severity: 'High',
      area: '0.36 m²',
      thumb: '/assets/samples/water_spill_main.jpg',
      note: 'Major slip hazard extending into main pedestrian path.'
    },
    {
      id: 3,
      timestamp: '00:18',
      frame: 540,
      detectedClass: 'Obstacle',
      confidence: 0.78,
      severity: 'Medium',
      area: '0.45 m²',
      thumb: '/assets/samples/thumb_obstacle.jpg',
      note: 'Dropped cardboard packaging obstructing forklift aisle.'
    },
    {
      id: 4,
      timestamp: '00:24',
      frame: 720,
      detectedClass: 'Clean Floor',
      confidence: 0.97,
      severity: 'Safe',
      thumb: '/assets/samples/thumb_clean_floor.jpg',
      note: 'Dry floor surface returning to safe corridor condition.'
    }
  ];

  const current = keyframes[selectedKeyframe];

  const runAnalysis = () => {
    setIsAnalyzing(true);
    setProgress(0);
    const interval = setInterval(() => {
      setProgress((p) => {
        if (p >= 100) {
          clearInterval(interval);
          setIsAnalyzing(false);
          return 100;
        }
        return p + 20;
      });
    }, 250);
  };

  return (
    <div className="p-6 space-y-6 max-w-[1720px] mx-auto">
      {/* Top Banner */}
      <div className="bg-[#131b29] border border-[#1e2c3f] rounded-2xl p-5 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2">
            <Video className="w-5 h-5 text-[#22c55e]" />
            <h2 className="text-base font-bold text-white tracking-tight">
              Offline Video Hazard Inspection
            </h2>
          </div>
          <p className="text-xs text-slate-400 mt-1">
            Evaluates pre-recorded inspection runs frame-by-frame, extracting keyframe hazard evidence without real-time CCTV streaming.
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
            onClick={runAnalysis}
            disabled={isAnalyzing}
            className="flex items-center gap-2 px-4 py-2 rounded-xl bg-[#22c55e] hover:bg-[#16a34a] text-black font-bold text-xs shadow-md transition-colors cursor-pointer"
          >
            <Play className="w-3.5 h-3.5 fill-current" />
            <span>{isAnalyzing ? `Analyzing Frames (${progress}%)` : 'Run Video Analysis'}</span>
          </button>
        </div>
      </div>

      {/* Main Analysis Layout */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        {/* Left Column (8 cols): Keyframe Preview & Timeline */}
        <div className="lg:col-span-8 bg-[#131b29] border border-[#1e2c3f] rounded-2xl p-5 space-y-4">
          <div className="flex items-center justify-between">
            <h3 className="text-sm font-bold text-white tracking-tight">Keyframe Evidence Player</h3>
            <span className="text-xs font-mono text-slate-400">
              Timestamp: <strong className="text-white">{current.timestamp}</strong> (Frame #{current.frame})
            </span>
          </div>

          {/* Active Frame Display */}
          <div className="relative rounded-xl overflow-hidden border border-[#202d42] bg-[#090e17] aspect-16/9 flex items-center justify-center">
            <img src={current.thumb} alt={current.detectedClass} className="w-full h-full object-cover" />

            {/* Overlay Stamp */}
            <div className="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/20 text-white font-mono text-xs flex items-center gap-2">
              <Clock className="w-3.5 h-3.5 text-[#22c55e]" />
              <span>{current.timestamp}</span>
              <span className="text-slate-400">|</span>
              <span
                className={`font-bold ${
                  current.severity === 'Safe' ? 'text-[#22c55e]' : 'text-[#ef4444]'
                }`}
              >
                {current.detectedClass.toUpperCase()}
              </span>
            </div>

            {current.severity !== 'Safe' && (
              <div className="absolute bottom-3 right-3 bg-[#ef4444]/90 backdrop-blur-md px-3 py-1 rounded-md text-white font-bold text-xs">
                {current.severity.toUpperCase()} RISK SLIP HAZARD
              </div>
            )}
          </div>

          {/* Keyframe Timeline Scrubber */}
          <div className="space-y-2 pt-2">
            <div className="text-xs font-bold text-slate-300">Sampled Keyframe Timeline</div>
            <div className="grid grid-cols-5 gap-2">
              {keyframes.map((kf, i) => (
                <button
                  key={kf.id}
                  onClick={() => setSelectedKeyframe(i)}
                  className={`p-1.5 rounded-xl border text-left transition-all cursor-pointer ${
                    selectedKeyframe === i
                      ? 'border-[#22c55e] bg-[#1a2c22] shadow-[0_0_10px_rgba(34,197,94,0.3)]'
                      : 'border-[#1b2738] bg-[#0d131f] hover:border-slate-500'
                  }`}
                >
                  <div className="aspect-16/10 rounded-md overflow-hidden bg-black mb-1">
                    <img src={kf.thumb} alt={kf.detectedClass} className="w-full h-full object-cover" />
                  </div>
                  <div className="flex items-center justify-between text-[10px] font-mono">
                    <span className="text-slate-300 font-bold">{kf.timestamp}</span>
                    <span
                      className={`font-bold ${
                        kf.severity === 'Safe' ? 'text-[#22c55e]' : 'text-[#ef4444]'
                      }`}
                    >
                      {kf.severity}
                    </span>
                  </div>
                  <div className="text-[10px] text-slate-400 truncate">{kf.detectedClass}</div>
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* Right Column (4 cols): Video Run Summary */}
        <div className="lg:col-span-4 bg-[#131b29] border border-[#1e2c3f] rounded-2xl p-5 space-y-4">
          <h3 className="text-sm font-bold text-white tracking-tight">Offline Video Summary</h3>

          <div className="p-4 rounded-xl bg-[#0d131f] border border-[#182335] space-y-2.5 text-xs font-mono">
            <div className="flex justify-between text-slate-300">
              <span className="text-slate-400">Source:</span>
              <span className="text-white truncate max-w-[180px]">{videoMeta.filename}</span>
            </div>
            <div className="flex justify-between text-slate-300">
              <span className="text-slate-400">Duration:</span>
              <span className="text-white">{videoMeta.duration}</span>
            </div>
            <div className="flex justify-between text-slate-300">
              <span className="text-slate-400">Resolution:</span>
              <span className="text-white">{videoMeta.resolution}</span>
            </div>
            <div className="flex justify-between text-slate-300">
              <span className="text-slate-400">Analyzed Frames:</span>
              <span className="text-white">{videoMeta.analyzedFrames}</span>
            </div>
            <div className="flex justify-between text-slate-300">
              <span className="text-slate-400">Hazard Events:</span>
              <span className="font-bold text-[#ef4444]">{videoMeta.hazardsDetected} incidents</span>
            </div>
          </div>

          {/* Incident Callout */}
          <div className="p-3.5 rounded-xl bg-[#231519] border border-[#ef4444]/40 space-y-2">
            <div className="flex items-center gap-2 text-xs font-bold text-[#ef4444]">
              <AlertTriangle className="w-4 h-4" />
              <span>Safety Assessment</span>
            </div>
            <p className="text-[11px] text-slate-200 leading-relaxed">
              Video inspection identified liquid pooling at timestamps 00:06 and 00:11. High slip probability along entrance artery. Corrective custodial intervention recommended before shift transition.
            </p>
          </div>
        </div>
      </div>
    </div>
  );
};
